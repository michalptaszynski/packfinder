{
  "_meta": {
    "version": "0.1",
    "currency": "GBP",
    "displayCurrencyRate": { "EUR": 1.17, "PLN": 5.05 },
    "priceBasis": "net unit price, base configuration (kraft, 1-colour print, outside coverage, no foil)",
    "interpolation": "log interpolation between curve points; extrapolation is forbidden – return 'get_a_quote' outside the range",
    "sourceLegend": {
      "observed": "data pulled from packhelp.co.uk – reliable",
      "mocked": "estimate for prototype purposes – DO NOT show as a binding quote"
    },
    "uiRule": "archetypes with source='mocked' render a 'estimated price' badge next to every amount",
    "photoPolicy": "four hero archetypes: Packhelp's own photography; the rest: Unsplash/Pexels with fixed IDs. Consistent register: one package in frame, clean background, minimal print, studio lighting."
  },

  "modifierLibrary": {
    "print.none":                  { "label": "No print",                 "unitDelta": 0.00 },
    "print.one_colour":             { "label": "1 colour",                 "unitDelta": 0.00 },
    "print.white_uv":               { "label": "White UV",                 "unitMultiplier": 1.15 },
    "print.multicolour_muted":      { "label": "Multicolour, muted",       "unitDelta": 0.09 },
    "print.multicolour_saturated":  { "label": "Multicolour, saturated",   "unitDelta": 0.18 },
    "print.multicolour_premium":    { "label": "Multicolour, premium",     "unitDelta": 0.31, "minQty": 120 },
    "coverage.outside":             { "label": "Outside coverage",         "unitMultiplier": 1.00 },
    "coverage.inside":              { "label": "Inside coverage",          "unitMultiplier": 1.12 },
    "coverage.inside_outside":      { "label": "Inside + outside",         "unitMultiplier": 1.22 },
    "material.kraft":               { "label": "Kraft",                    "unitMultiplier": 1.00, "eco": true },
    "material.white":               { "label": "White",                    "unitMultiplier": 1.06, "eco": true },
    "material.white_both":          { "label": "White, both sides",        "unitMultiplier": 1.14, "eco": true },
    "material.coated":              { "label": "Coated",                   "unitMultiplier": 1.20, "eco": false },
    "finish.none":                  { "label": "No finish",                "unitDelta": 0.00 },
    "finish.matte_foil":            { "label": "Matte foil",               "unitMultiplier": 1.18, "breaksEco": true },
    "finish.glossy_foil":           { "label": "Gloss foil",               "unitMultiplier": 1.18, "breaksEco": true },
    "finish.hot_stamping":          { "label": "Hot stamping",             "unitDelta": 0.42, "minQty": 120 },
    "finish.embossing":             { "label": "Embossing",                "unitDelta": 0.35, "minQty": 120 },
    "closure.none":                 { "label": "No strip",                 "unitDelta": 0.00 },
    "closure.single_strip":         { "label": "Adhesive strip",           "unitDelta": 0.04 },
    "closure.double_strip":         { "label": "Double strip (returns)",   "unitDelta": 0.07 }
  },

  "addons": {
    "tissue_paper":   { "label": "Printed tissue paper",  "minQty": 30,  "unitDelta": 0.12, "source": "mocked" },
    "branded_tape":   { "label": "Branded tape",           "minQty": 36,  "unitDelta": 0.06, "source": "mocked" },
    "stickers":       { "label": "Stickers",                "minQty": 250, "unitDelta": 0.05, "source": "mocked" },
    "insert":         { "label": "Insert / tray",          "minQty": 240, "unitDelta": 0.28, "source": "mocked" },
    "thank_you_card": { "label": "Thank-you card",         "minQty": 30,  "unitDelta": 0.09, "source": "mocked" },
    "void_fill":      { "label": "Void fill",              "minQty": 1,   "unitDelta": 0.03, "source": "mocked" }
  },

  "archetypes": [
    {
      "id": "mailer",
      "label": "Mailer box",
      "story": "The e-commerce classic. Opens like a book – the best unboxing-effect-to-price ratio.",
      "channels": ["courier", "parcel_locker", "gift"],
      "protection": "medium",
      "moq": 30,
      "leadTimeDays": 8,
      "assetTier": "full",
      "priceCurve": {
        "source": "observed",
        "note": "Custom Mailer Box F23 (9.2 x 9.2 x 5 cm), kraft, 1 colour, outside coverage",
        "points": [
          { "qty": 30, "unit": 1.58 }, { "qty": 60, "unit": 1.03 }, { "qty": 90, "unit": 0.82 },
          { "qty": 120, "unit": 0.74 }, { "qty": 240, "unit": 0.52 }, { "qty": 500, "unit": 0.40 },
          { "qty": 750, "unit": 0.36 }, { "qty": 1000, "unit": 0.34 }, { "qty": 2000, "unit": 0.34 }
        ]
      },
      "sizes": [
        { "code": "S", "mm": [92, 92, 50], "fits": ["InPost A", "Royal Mail Small", "DPD S"] },
        { "code": "M", "mm": [350, 260, 100], "fits": ["InPost B", "DPD M"] },
        { "code": "L", "mm": [364, 314, 125], "fits": ["InPost C"] }
      ],
      "sizeMultiplier": { "S": 1.00, "M": 2.35, "L": 2.90 },
      "allowedModifiers": [
        "print.one_colour", "print.white_uv", "print.multicolour_muted", "print.multicolour_saturated", "print.multicolour_premium",
        "coverage.outside", "coverage.inside", "coverage.inside_outside",
        "material.kraft", "material.white", "material.white_both", "material.coated",
        "finish.none", "finish.matte_foil", "finish.glossy_foil", "finish.hot_stamping",
        "closure.none", "closure.single_strip", "closure.double_strip"
      ],
      "constraints": [
        { "if": ["print.multicolour_muted"], "forbid": ["coverage.inside", "coverage.inside_outside"], "reason": "Muted print doesn't support background or inside coverage." },
        { "if": ["print.multicolour_saturated"], "forbid": ["coverage.inside"], "reason": "Saturated print isn't available as inside-only." },
        { "if": ["print.multicolour_premium", "coverage.inside_outside"], "require": ["material.white_both"], "reason": "Premium on both sides requires white material on both sides." }
      ],
      "assets": { "photo": "/photos/mailer.jpg", "photoSource": "packhelp", "aspect": 0.8, "fallback": "/schematics/mailer.svg" }
    },

